ColorButton.MouseButton1Click:Connect(function()
    local colors = {
        Color3.fromRGB(0, 255, 255), Color3.fromRGB(255, 0, 255),
        Color3.fromRGB(255, 255, 0), Color3.fromRGB(0, 255, 0),
        Color3.fromRGB(255, 0, 0), Color3.fromRGB(0, 128, 255),
        Color3.fromRGB(255, 128, 0), Color3.fromRGB(150, 0, 255)
    }
    local currentIndex = 1
    for i, color in ipairs(colors) do
        if math.abs(color.R - config.color.R) < 0.01 then currentIndex = i break end
    end
    config.color = colors[(currentIndex % #colors) + 1]
    ColorButton.BackgroundColor3 = config.color
    saveConfig()
end)

